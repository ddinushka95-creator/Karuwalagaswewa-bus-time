<!doctype html>
<html lang="si">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#123b32"><title>Karuwalagaswewa Bus Time</title>
<style>
:root{--green:#123b32;--green2:#1e6654;--bg:#f3f7f5;--ink:#17231f;--muted:#66756f;--line:#dce7e1;--white:#fff;--gold:#e9b949}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,"Noto Sans Sinhala",sans-serif;color:var(--ink)}header{background:linear-gradient(135deg,var(--green),var(--green2));color:white;padding:24px 18px 28px}header .top{max-width:850px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:12px}h1{font-size:clamp(23px,5vw,34px);margin:8px 0 4px}.sub{opacity:.86;font-size:14px}.wrap{max-width:850px;margin:-14px auto 40px;padding:0 14px}.panel{background:white;border:1px solid var(--line);border-radius:17px;padding:17px;margin:14px 0;box-shadow:0 5px 18px #183d2b0b}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.grow{flex:1;min-width:180px}input,select,textarea,button{font:inherit;border-radius:10px;padding:12px;border:1px solid var(--line);background:white;color:var(--ink);width:100%}button{background:var(--green);color:white;border:0;font-weight:650;cursor:pointer;width:auto}button.secondary{background:#eaf2ee;color:var(--green)}button.small{padding:8px 11px;font-size:13px}.label{font-size:13px;color:var(--muted);display:block;margin:0 0 6px}.bus{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.bus:last-child{border:0;padding-bottom:0}.time{font-size:27px;font-weight:800;color:var(--green);white-space:nowrap;font-variant-numeric:tabular-nums}.name{font-weight:750;font-size:16px}.meta{font-size:13px;color:var(--muted);margin-top:4px}.tag{display:inline-block;background:#edf5f0;color:#235d4c;border-radius:30px;padding:4px 9px;font-size:11px;margin-top:7px}.muted{color:var(--muted);font-size:13px}.hidden{display:none!important}h2{font-size:18px;margin:0 0 13px}.notice{background:#fff8e8;border:1px solid #f1dfb4;border-radius:11px;padding:11px;color:#73561a;font-size:13px;line-height:1.5}.footer{text-align:center;color:var(--muted);font-size:12px;padding:12px}#adminBox{border:1px dashed #a6b8ae}#pendingList .bus{align-items:flex-start}
</style></head>
<body>
<header><div class="top"><div><div style="font-size:12px;letter-spacing:1.4px;opacity:.8">LOCAL BUS TIMETABLE</div><h1>Karuwalagaswewa Bus Time</h1><div class="sub" id="tagline">කරුවලගස්වැව බස් වේලාවන්</div></div><button class="secondary small" id="langBtn" onclick="toggleLang()">English</button></div></header>
<main class="wrap">
<section class="panel"><div class="row"><div class="grow"><label class="label" id="searchLabel">ගමනාන්තය හෝ බස් නම සොයන්න</label><input id="search" placeholder="වව්නියාව / කොළඹ / D.S. Gunasekara" oninput="render()"></div><div class="grow"><label class="label" id="dirLabel">ගමන් දිශාව</label><select id="direction" onchange="render()"><option value="all">සියල්ල</option><option value="out">කරුවලගස්වැවෙන් පිටත්වන</option><option value="through">කරුවලගස්වැව හරහා යන</option></select></div></div></section>
<section class="panel"><div class="row" style="justify-content:space-between"><h2 id="listTitle">බස් වේලාවන්</h2><span class="tag" id="count">2 සේවා</span></div><div id="busList"></div></section>
<section class="panel"><h2 id="submitTitle">නව බස් වේලාවක් යෝජනා කරන්න</h2><p class="muted" id="submitDesc">ඔබ එවන තොරතුරු පරිපාලකයා අනුමත කළ පසු පමණක් මහජනයාට පෙන්විය යුතුය.</p>
<form id="proposalForm"><div class="row"><div class="grow"><label class="label" id="busNameLabel">බස් නම / සමාගම</label><input name="name" required placeholder="D.S. Gunasekara"></div><div class="grow"><label class="label" id="routeLabel">මාර්ග අංකය (තිබේ නම්)</label><input name="route" placeholder="87/04"></div></div><div class="row" style="margin-top:10px"><div class="grow"><label class="label" id="destLabel">ගමනාන්තය</label><input name="destination" required placeholder="Vavuniya"></div><div class="grow"><label class="label" id="timeLabel">කරුවලගස්වැවට පැමිණෙන වේලාව</label><input name="time" required type="time"></div></div><div class="row" style="margin-top:10px"><div class="grow"><label class="label" id="typeLabel">බස් වර්ගය</label><select name="type"><option>SLTB / CTB</option><option>Private</option><option>Normal</option><option>Semi Luxury</option><option>Luxury</option><option>Other</option></select></div><div class="grow"><label class="label" id="directionFormLabel">ගමන් දිශාව</label><select name="direction"><option value="through">කරුවලගස්වැව හරහා යන</option><option value="out">කරුවලගස්වැවෙන් පිටත්වන</option></select></div></div><div style="margin-top:10px"><label class="label" id="notesLabel">අමතර සටහන (විකල්ප)</label><textarea name="notes" rows="2" placeholder="දිනපතා / සතියේ දිනවල"></textarea></div><div style="margin-top:12px"><button type="submit" id="submitBtn">යෝජනාව යවන්න</button></div></form><p class="muted" id="submitResult" aria-live="polite"></p></section>
<section class="panel" id="adminBox"><div class="row" style="justify-content:space-between"><h2 id="adminTitle">පරිපාලක පරීක්ෂණ කොටස</h2><button class="secondary small" onclick="toggleAdmin()" id="adminToggle">පෙන්වන්න</button></div><div id="adminContent" class="hidden"><div class="notice" id="adminNotice">මෙය පරීක්ෂණ අනුවාදයකි. දත්ත මෙම උපාංගයේ browser එකේ පමණක් සුරැකේ. මෙය සජීවී අන්තර්ජාල ආරක්ෂාවක් නොවේ.</div><div id="adminLogin" style="margin-top:12px"><label class="label" for="adminPassword">Admin මුරපදය</label><div class="row"><div class="grow"><input id="adminPassword" type="password" placeholder="මුරපදය ඇතුළත් කරන්න" autocomplete="current-password"></div><button onclick="loginAdmin()">පිවිසෙන්න</button></div><p class="muted" id="loginResult" aria-live="polite"></p></div><div id="adminTools" class="hidden"><div class="row" style="justify-content:space-between;margin-top:14px"><b>බස් තොරතුරු කළමනාකරණය</b><button class="secondary small" onclick="logoutAdmin()">ඉවත් වන්න</button></div><div id="manageList" style="margin-top:8px"></div><h2 style="margin-top:18px">අනුමැතිය බලාපොරොත්තුවෙන්</h2><div id="pendingList" style="margin-top:10px"></div></div></div></section>
<div class="footer">Karuwalagaswewa Bus Time · Prototype preview</div>
</main>
<script>
const initial=[
{id:1,name:'D.S. Gunasekara',destination:'Vavuniya',time:'04:35',direction:'through',type:'Not specified',route:'',notes:'කරුවලගස්වැව හරහා වව්නියාව බලා',approved:true},
{id:2,name:'D.S. Gunasekara',destination:'Colombo',time:'04:45',direction:'through',type:'Not specified',route:'',notes:'වව්නියාවේ සිට කොළඹ බලා කරුවලගස්වැව හරහා',approved:true}
];
let buses=JSON.parse(localStorage.getItem('kw_buses')||'null')||initial;let pending=JSON.parse(localStorage.getItem('kw_pending')||'[]');let lang='si';let adminUnlocked=false;const ADMIN_HASH='8802fa1ef808df476921748026a929cbff014ec771e098d2a747b6cad14438b9';
const tr={si:{tag:'කරුවලගස්වැව බස් වේලාවන්',search:'ගමනාන්තය හෝ බස් නම සොයන්න',dir:'ගමන් දිශාව',all:'සියල්ල',out:'කරුවලගස්වැවෙන් පිටත්වන',through:'කරුවලගස්වැව හරහා යන',list:'බස් වේලාවන්',submit:'නව බස් වේලාවක් යෝජනා කරන්න',desc:'ඔබ එවන තොරතුරු පරිපාලකයා අනුමත කළ පසු පමණක් මහජනයාට පෙන්විය යුතුය.',name:'බස් නම / සමාගම',route:'මාර්ග අංකය (තිබේ නම්)',dest:'ගමනාන්තය',time:'කරුවලගස්වැවට පැමිණෙන වේලාව',type:'බස් වර්ගය',dirform:'ගමන් දිශාව',notes:'අමතර සටහන (විකල්ප)',send:'යෝජනාව යවන්න',sent:'යෝජනාව මෙම උපාංගයේ පරීක්ෂණ ලැයිස්තුවට එක් කළා.',admin:'පරිපාලක පරීක්ෂණ කොටස',show:'පෙන්වන්න',hide:'සඟවන්න',pending:'අනුමැතිය බලාපොරොත්තුවෙන්',approve:'අනුමත කරන්න',reject:'ප්‍රතික්ෂේප කරන්න',arrive:'කරුවලගස්වැවට පැමිණීම',empty:'ගැළපෙන බස් වේලාවක් නැහැ.'},en:{tag:'Bus times at Karuwalagaswewa',search:'Search destination or bus name',dir:'Direction',all:'All',out:'Departing from Karuwalagaswewa',through:'Passing through Karuwalagaswewa',list:'Bus timetable',submit:'Suggest a bus time',desc:'Suggestions should appear publicly only after admin approval.',name:'Bus / operator name',route:'Route number (if available)',dest:'Destination',time:'Arrival time at Karuwalagaswewa',type:'Bus type',dirform:'Direction',notes:'Additional note (optional)',send:'Submit suggestion',sent:'Suggestion added to this device’s demo review list.',admin:'Admin preview section',show:'Show',hide:'Hide',pending:'Awaiting approval',approve:'Approve',reject:'Reject',arrive:'Arrives at Karuwalagaswewa',empty:'No matching bus times found.'}};
function save(){localStorage.setItem('kw_buses',JSON.stringify(buses));localStorage.setItem('kw_pending',JSON.stringify(pending))}
function render(){const t=tr[lang],q=document.getElementById('search').value.toLowerCase(),d=document.getElementById('direction').value;let rows=buses.filter(b=>b.approved&&(d==='all'||b.direction===d)&&[b.name,b.destination,b.route,b.notes].join(' ').toLowerCase().includes(q)).sort((a,b)=>a.time.localeCompare(b.time));document.getElementById('busList').innerHTML=rows.length?rows.map(b=>`<div class="bus"><div><div class="name">${esc(b.name)}</div><div>${esc(b.destination)} ${b.route?'· '+esc(b.route):''}</div><div class="meta">${t.arrive} · ${esc(b.type||'')}</div><span class="tag">${b.direction==='through'?t.through:t.out}</span>${b.notes?`<div class="meta">${esc(b.notes)}</div>`:''}</div><div class="time">${fmt(b.time)}</div></div>`).join(''):`<p class="muted">${t.empty}</p>`;document.getElementById('count').textContent=rows.length+(lang==='si'?' සේවා':' services');renderPending()}
function fmt(x){let [h,m]=x.split(':').map(Number);return `${String(h%12||12).padStart(2,'0')}:${String(m).padStart(2,'0')} ${h<12?'AM':'PM'}`}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toggleLang(){lang=lang==='si'?'en':'si';let t=tr[lang];document.getElementById('langBtn').textContent=lang==='si'?'English':'සිංහල';for(let [id,key] of Object.entries({tagline:'tag',searchLabel:'search',dirLabel:'dir',listTitle:'list',submitTitle:'submit',submitDesc:'desc',busNameLabel:'name',routeLabel:'route',destLabel:'dest',timeLabel:'time',typeLabel:'type',directionFormLabel:'dirform',notesLabel:'notes',submitBtn:'send',adminTitle:'admin',adminToggle:'show'}))document.getElementById(id).textContent=t[key];let sel=document.getElementById('direction');sel.options[0].text=t.all;sel.options[1].text=t.out;sel.options[2].text=t.through;render()}
document.getElementById('proposalForm').addEventListener('submit',e=>{e.preventDefault();let f=new FormData(e.target),b=Object.fromEntries(f.entries());b.id=Date.now();b.approved=false;pending.push(b);save();e.target.reset();document.getElementById('submitResult').textContent=tr[lang].sent;render()});
function toggleAdmin(){let el=document.getElementById('adminContent');el.classList.toggle('hidden');document.getElementById('adminToggle').textContent=el.classList.contains('hidden')?tr[lang].show:tr[lang].hide}
async function loginAdmin(){let pass=document.getElementById('adminPassword').value;let digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(pass));let hash=[...new Uint8Array(digest)].map(x=>x.toString(16).padStart(2,'0')).join('');if(hash===ADMIN_HASH){adminUnlocked=true;document.getElementById('adminLogin').classList.add('hidden');document.getElementById('adminTools').classList.remove('hidden');document.getElementById('loginResult').textContent='';renderPending();renderManage()}else{document.getElementById('loginResult').textContent='මුරපදය වැරදියි. නැවත උත්සාහ කරන්න.'}}
function logoutAdmin(){adminUnlocked=false;document.getElementById('adminTools').classList.add('hidden');document.getElementById('adminLogin').classList.remove('hidden');document.getElementById('adminPassword').value=''}
function renderManage(){if(!adminUnlocked)return;let el=document.getElementById('manageList');el.innerHTML=buses.length?buses.map(b=>`<div class="bus"><div><b>${esc(b.name)}</b><div class="meta">${esc(b.destination)} · ${fmt(b.time)}</div></div><div class="row"><button class="small" onclick="editBus(${b.id})">Edit</button><button class="small secondary" onclick="deleteBus(${b.id})">මකන්න</button></div></div>`).join(''):'<p class="muted">බස් තොරතුරු නැහැ.</p>'}
function editBus(id){if(!adminUnlocked)return;let b=buses.find(x=>x.id===id);if(!b)return;let name=prompt('බස් නම',b.name);if(name===null)return;let destination=prompt('ගමනාන්තය',b.destination);if(destination===null)return;let time=prompt('වේලාව (HH:MM)',b.time);if(time===null)return;if(!/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/.test(time)){alert('වේලාව 24 පැය ආකාරයට ඇතුළත් කරන්න. උදා: 04:35');return}b.name=name.trim();b.destination=destination.trim();b.time=time.padStart(5,'0');save();render();renderManage()}
function deleteBus(id){if(!adminUnlocked)return;if(!confirm('මෙම බස් තොරතුර මකා දමන්නද?'))return;buses=buses.filter(x=>x.id!==id);save();render();renderManage()}
function renderPending(){if(!adminUnlocked)return;let t=tr[lang],el=document.getElementById('pendingList');el.innerHTML=pending.length?pending.map(b=>`<div class="bus"><div><b>${esc(b.name)}</b><div class="meta">${esc(b.destination)} · ${fmt(b.time)}</div><div class="meta">${esc(b.type)} · ${esc(b.route||'')}</div></div><div class="row"><button class="small" onclick="approve(${b.id})">${t.approve}</button><button class="small secondary" onclick="reject(${b.id})">${t.reject}</button></div></div>`).join(''):`<p class="muted">${t.pending}: 0</p>`}
function approve(id){if(!adminUnlocked)return;let b=pending.find(x=>x.id===id);if(!b)return;b.approved=true;b.id=Date.now();buses.push(b);pending=pending.filter(x=>x.id!==id);save();render();renderManage()}
function reject(id){if(!adminUnlocked)return;pending=pending.filter(x=>x.id!==id);save();render();renderManage()}
render();
</script></body></html>
